# Telegram
BOT_TOKEN=123456:your-bot-token-from-botfather
ADMIN_IDS=123456789,987654321
WEBHOOK_SECRET=change-me-to-a-random-string
# Public HTTPS URL of this server (Caddy domain), no trailing slash
PUBLIC_URL=https://your-domain.com
WEB_APP_URL=https://your-domain.com/app

# Database
DATABASE_URL=postgresql+asyncpg://botuser:botpass@postgres:5432/botdb
POSTGRES_USER=botuser
POSTGRES_PASSWORD=botpass
POSTGRES_DB=botdb

# Payments
CARD_NUMBER=8600 0000 0000 0000
CARD_HOLDER=F. F. LASTNAME
STARS_TO_UZS_RATE=200
REFERRAL_BONUS_PERCENT=5
P2P_COMMISSION_PERCENT=3

# TON hot wallet (Stage 2) -- leave TON_WALLET_MNEMONIC empty to keep TON/Fragment features disabled.
# Generate a NEW wallet just for the bot, fund it lightly, keep the mnemonic only here, never in git.
TON_WALLET_MNEMONIC=
TON_API_KEY=
TON_NETWORK=mainnet
TON_RATE_UZS=0
USDT_RATE_UZS=0
TON_MONITOR_INTERVAL_SECONDS=20
TON_REQUEST_TTL_MINUTES=60

# Fragment (fragment.com) session -- obtained by logging into fragment.com in a browser with a
# Telegram account that has a TON wallet connected, then copying these cookies from devtools.
# Empty = Fragment auto-buy disabled, Premium/Stars orders always go to manual admin fulfillment.
FRAGMENT_STEL_SSID=
FRAGMENT_STEL_DT=
FRAGMENT_STEL_TOKEN=
FRAGMENT_STEL_TON_TOKEN=
FRAGMENT_TIMEOUT_SECONDS=120

# Web admin panel (/admin) -- random string, keep secret
ADMIN_SESSION_SECRET=change-me-to-a-random-string
